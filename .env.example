# Semicolon-separated transaction CSV paths (required in Compose)
BENCHMARKS_CSV_PATHS=/data/transactions-2026-02-23.csv;/data/Transactions.csv

# Residential sale index CSV (empty string skips index load)
INDEX_CSV_PATH=/data/Residential_Sale_Index.csv

# Area unit in DLD transaction CSVs: sqm | sqft
DLD_AREA_UNIT=sqm

# Price-per-sqft bounds (AED/sqft) for outlier filtering
PPSF_MIN=100
PPSF_MAX=20000

# Bind port (container listens on 8001 in Compose)
PORT=8001

# Echoed in GET /health
APP_ENV=local

# --- MongoDB (optional; reserved for future persistence / metadata) ---
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=
MONGO_DB=RECALMI
MONGO_COLLECTION_READY=ready
MONGO_COLLECTION_OFFPLAN=off-plan

# ── Admin reload auth (ST-053) ─────────────────────────────────────────────
# DATA_SERVICE_TOKEN — shared secret for POST /v1/admin/reload.
# Required; no default. Unset or empty → admin reload returns 503 (fail-closed).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real value here.
DATA_SERVICE_TOKEN=

# MAX_RELOAD_S — max seconds to wait for one reload ingest before timeout.
# On timeout the prior snapshot is preserved and HTTP 503 is returned. Default: 300.
# Must be > 0 (non-numeric or ≤ 0 → startup validation error).
MAX_RELOAD_S=300

# ADMIN_RELOAD_COOLDOWN_S — min seconds between reload attempts (AVAIL-01).
# Default: 5. Set 0 to disable (not recommended outside local dev).
ADMIN_RELOAD_COOLDOWN_S=5

# Operator reload example (after setting DATA_SERVICE_TOKEN above):
# curl -X POST http://127.0.0.1:8001/v1/admin/reload \
#      -H "Authorization: Bearer ${DATA_SERVICE_TOKEN}"
